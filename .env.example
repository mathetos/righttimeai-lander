# MailerLite API key for the subscribe form (beta access signup).
# Get a key at https://developers.mailerlite.com/
#
# Local dev: set this in .env.local (NOT .env) — Next.js overrides .env with .env.local.
# Then restart the dev server (npm run dev).
#
# Vercel: add MAILERLITE_API_KEY in Project Settings → Environment Variables.
MAILERLITE_API_KEY=

# Cloudflare Turnstile (opt-in form protection).
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Add domains in the widget: localhost, *.vercel.app, righttime.ai (or your prod domain).
#
# Local / preview: use Cloudflare test keys (always pass):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#
# Vercel (preview + production): use real keys and set both in Environment Variables.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
